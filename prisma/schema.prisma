generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobType {
  ENHANCE
  PHOTOSHOOT
  EDIT
  ERASE
  TRYON
  HAIRSTYLE
  LOOK
}

enum GarmentCategory {
  UPPER_BODY
  LOWER_BODY
  DRESSES
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  REJECTED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum AssetKind {
  SOURCE
  RESULT
  SELFIE_TRAINING
}

enum StyleKind {
  OCCASION
  TEMPLATE
  CLEANUP
}

model User {
  id             String              @id
  email          String              @unique
  passwordHash   String
  ageConfirmedAt DateTime?
  /// Code de parrainage partagé par l'utilisateur ; `referredById` = parrain éventuel.
  referralCode   String              @unique
  referredById   String?
  referredBy     User?               @relation("Referral", fields: [referredById], references: [id])
  referrals      User[]              @relation("Referral")
  /// Compte supprimé (anonymisé) : l'email et le mot de passe ont été remplacés, les photos effacées.
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  assets         Asset[]
  jobs           Job[]
  posts          Post[]
  payments       Payment[]
  ledger         CreditTransaction[]
}

model Asset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      AssetKind
  bucket    String
  key       String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([bucket, key])
  @@index([userId])
}

/// Tenue du catalogue (essayage virtuel). L'image est dans le bucket privé "garments".
/// license + author : on ne publie que des visuels dont on a le droit (couturier partenaire, généré par IA, banque sous licence).
model Garment {
  id          String          @id
  name        String
  category    GarmentCategory
  description String?
  bucket      String          @default("garments")
  key         String
  author      String?
  license     String
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  jobs        Job[]

  @@unique([bucket, key])
}

model StyleTemplate {
  id         String    @id
  name       String
  kind       StyleKind
  creditCost Int
  previewUrl String?
  active     Boolean   @default(true)
  jobs       Job[]
}

enum PostVisibility {
  PUBLIC
  UNLISTED
}

/// Look publié dans le fil. L'image est une COPIE (results/<userId>/post-<id>.<ext>) : elle échappe à la purge des résultats
/// et disparaît avec le post ou le compte. jobId/garmentId/hairstyleId sont de simples références (le job est purgé après 30 jours).
model Post {
  id          String         @id
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  jobId       String
  imageKey    String
  visibility  PostVisibility
  caption     String?
  garmentId   String?
  hairstyleId String?
  makeupId    String?
  accessoryIds String[]       @default([])
  /// Occasion (fond) du look : id d'un StyleTemplate, sans relation.
  occasionId  String?
  reportCount Int            @default(0)
  createdAt   DateTime       @default(now())
  likes       PostLike[]
  reports     PostReport[]

  @@unique([userId, jobId])
  @@index([visibility, createdAt, id])
  @@index([userId, createdAt])
}

model PostLike {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

model PostReport {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  reason    String
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

model Job {
  id             String         @id
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  type           JobType
  prompt         String?
  styleId        String?
  style          StyleTemplate? @relation(fields: [styleId], references: [id])
  garmentId      String?
  garment        Garment?       @relation(fields: [garmentId], references: [id])
  /// Coiffure du catalogue statique (packages/shared) : pas de table, donc pas de relation.
  hairstyleId    String?
  /// Look composé : maquillage et accessoires du catalogue statique (styleId = l'occasion).
  makeupId       String?
  accessoryIds   String[]       @default([])
  creditCost     Int
  status         JobStatus
  inputAssetIds  String[]
  outputAssetIds String[]
  errorReason    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  moderationLogs ModerationLog[]

  @@index([userId, createdAt])
}

/// Append-only : jamais d'UPDATE/DELETE. Solde = SUM(amount).
model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  paymentId String?  @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

model Payment {
  id          String        @id
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  packId      String
  credits     Int
  amount      Int
  currency    String
  phone       String
  operator    String
  providerRef String        @unique
  status      PaymentStatus
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ModerationLog {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  stage      String
  approved   Boolean
  nsfwScore  Float
  minorRisk  Boolean
  faceCount  Int
  createdAt  DateTime @default(now())

  @@index([jobId])
}


/// Réponses mémorisées pour l'en-tête Idempotency-Key (POST /jobs, /payments/initiate).
model IdempotencyRecord {
  key        String
  userId     String
  statusCode Int
  body       Json
  createdAt  DateTime @default(now())

  @@id([userId, key])
}

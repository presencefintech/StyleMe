# --- API ---
PORT=3001
DATABASE_URL=postgresql://postgres:password@db.<project>.supabase.co:5432/postgres   # Postgres Supabase (pooler)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # BACKEND ONLY, jamais cote web
REDIS_URL=redis://localhost:6379
JWT_SECRET=                         # >= 16 caracteres
CORS_ORIGIN=http://localhost:3000   # origines du front, separees par des virgules

# --- IA ---
AI_MODE=local                       # local | api
LOCAL_AI_URL=http://localhost:8000  # microservice Python (si AI_MODE=local ou MODERATION_PROVIDER=local)
REPLICATE_TOKEN=
REPLICATE_UPSCALE_MODEL=
REPLICATE_FACE_MODEL=
REMOVEBG_KEY=
MODERATION_PROVIDER=local           # local | sightengine
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# --- Paiement (Flexpay) ---
PAYMENT_PROVIDER=flexpay
PAYMENT_API_URL=https://backend.flexpay.cd/api/rest/v1/paymentService
PAYMENT_API_KEY=
PAYMENT_MERCHANT=
PAYMENT_CALLBACK_URL=https://<api-domain>/api/v1/payments/webhook
PAYMENT_WEBHOOK_SECRET=
